rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The whole data model hangs off a user, so a single owner rule covers
    // users/{uid}/sales, users/{uid}/customers and users/{uid}/items at once.
    // Subcollections are not covered by a rule on their parent document, so
    // the recursive {document=**} match is required.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}